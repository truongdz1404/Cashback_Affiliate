# Used by docker-compose.yml at deploy time (VPS-side .env, never commit the real one)

# Same value the Playwright service checks on every request (x-api-key header)
SERVICE_API_KEY=change-me

# Zalo Bot API token (bot.zaloplatforms.com) and the webhook secret it sends
# back as x-bot-api-secret-token on every call to /zalo-webhook
ZALO_BOT_TOKEN=change-me
ZALO_WEBHOOK_SECRET=change-me

# Credentials for the shopee-affiliate-db Postgres container (bound to
# 127.0.0.1:5433 on the VPS only, since 5432 is already taken by the
# unrelated tro247_db container - connect via Navicat's SSH Tunnel feature,
# never expose this port publicly). DATABASE_URL is assembled from these in
# docker-compose.yml, so keep them in sync if you change one.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopee_affiliate

# Credentials for the rabbitmq container (not exposed publicly - only
# reachable from shopee-affiliate/withdrawal-worker over shared_net).
# Backs the withdrawal-creation queue (see playwright-service/lib/queue/).
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me

# Health check: email alerts when services go down (every 30 minutes)
# SMTP_USER / SMTP_PASS: for Gmail, create an App Password at
#   https://myaccount.google.com/apppasswords (requires 2FA enabled)
ALERT_EMAIL_TO=your@email.com
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
