# Used by docker-compose.yml at deploy time (VPS-side .env, never commit the real one)

# Same value the Playwright service checks on every request (x-api-key header)
SERVICE_API_KEY=change-me

# Zalo Bot API token (bot.zaloplatforms.com) and the webhook secret it sends
# back as x-bot-api-secret-token on every call to /zalo-webhook
ZALO_BOT_TOKEN=change-me
ZALO_WEBHOOK_SECRET=change-me
