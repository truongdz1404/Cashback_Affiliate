# Port the microservice listens on
PORT=4000

# Public origin this service is reachable at, used only to build absolute
# URLs (e.g. bank logo images returned by GET /app/banks). Defaults to the
# production domain if unset.
PUBLIC_BASE_URL=https://refundmoney.tro247.online

# Run Chromium headless (true) or with a visible window for debugging (false)
HEADLESS=true

# How many logged-in custom-link tabs (lib/browserManager.js) are kept warm
# and reused for POST /app/link and POST /app/shopping-products/:id/open.
# Default 2 - the VPS is only 2 core/4GB RAM, and each warm tab is a real
# Chrome process; raise this only once the VPS has more RAM headroom.
CUSTOM_LINK_POOL_SIZE=2

# Starting share of links minted through Shopee's documented an_redir
# redirector (lib/anRedirLink.js) instead of the Playwright "Lấy link" page.
# 0 keeps every link on the old path, 100 moves them all.
#
# Only the starting value: the live dial is Cài đặt -> "Link qua an_redir" in
# the dashboard (settings key an_redir_percent), so turning it down does not
# need a redeploy. This is read only while that setting has never been saved.
# Kept at 0 until a real order confirms an an_redir sub id lands in the
# conversion report - see docs/shopee-affiliate-api-spec.txt §8.
SHOPEE_AN_REDIR_PERCENT=0

# Shared secret n8n must send as `x-api-key` header on every request.
# Generate any random string, e.g. `openssl rand -hex 20`.
SERVICE_API_KEY=change-me

# Comma-separated emails that are promoted to role=admin automatically the
# moment they sign in (Google, Facebook or phone login with that email on the
# account) - the bootstrap for the very first administrator, see
# lib/adminAuth.js#syncRoleFromAllowlist. Further admins are granted from the
# dashboard (Khách hàng -> Cấp quyền) or `npm run set-role`. Defaults to
# truongvq.se@gmail.com if unset.
ADMIN_EMAILS=truongvq.se@gmail.com

# Where the logged-in browser session (cookies/localStorage) is persisted
# between requests so you don't have to re-inject cookies every call.
STORAGE_STATE_PATH=./storage/storageState.json

# Zalo Bot API token from bot.zaloplatforms.com (format 12345689:abc-xyz).
# Used to call https://bot-api.zaloplatforms.com/bot<TOKEN>/sendMessage.
ZALO_BOT_TOKEN=change-me

# Secret Zalo sends back as the x-bot-api-secret-token header on every
# webhook call to /zalo-webhook - set the same value in the bot's webhook
# config at bot.zaloplatforms.com.
ZALO_WEBHOOK_SECRET=change-me

# Postgres connection string Prisma reads via prisma/schema.prisma's
# datasource block. In docker-compose this is assembled from POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DB; for local `node server.js` runs against a
# standalone Postgres, set the full URL directly, e.g.:
# postgresql://postgres:postgres@localhost:5433/shopee_affiliate
DATABASE_URL=change-me

# RabbitMQ connection used by the withdrawal-creation queue (see
# lib/queue/connection.js). In docker-compose RABBITMQ_HOST defaults to the
# `rabbitmq` service name; for a local `node server.js` run against a
# standalone broker, set RABBITMQ_HOST=localhost too.
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
