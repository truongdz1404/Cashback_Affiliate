# Port the microservice listens on
PORT=4000

# Run Chromium headless (true) or with a visible window for debugging (false)
HEADLESS=true

# Shared secret n8n must send as `x-api-key` header on every request.
# Generate any random string, e.g. `openssl rand -hex 20`.
SERVICE_API_KEY=change-me

# Where the logged-in browser session (cookies/localStorage) is persisted
# between requests so you don't have to re-inject cookies every call.
STORAGE_STATE_PATH=./storage/storageState.json

# Zalo Bot API token from bot.zaloplatforms.com (format 12345689:abc-xyz).
# Used to call https://bot-api.zaloplatforms.com/bot<TOKEN>/sendMessage.
ZALO_BOT_TOKEN=change-me

# Secret Zalo sends back as the x-bot-api-secret-token header on every
# webhook call to /zalo-webhook - set the same value in the bot's webhook
# config at bot.zaloplatforms.com.
ZALO_WEBHOOK_SECRET=change-me

# Postgres connection string Prisma reads via prisma/schema.prisma's
# datasource block. In docker-compose this is assembled from POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DB; for local `node server.js` runs against a
# standalone Postgres, set the full URL directly, e.g.:
# postgresql://postgres:postgres@localhost:5433/shopee_affiliate
DATABASE_URL=change-me

# RabbitMQ connection used by the withdrawal-creation queue (see
# lib/queue/connection.js). In docker-compose RABBITMQ_HOST defaults to the
# `rabbitmq` service name; for a local `node server.js` run against a
# standalone broker, set RABBITMQ_HOST=localhost too.
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
