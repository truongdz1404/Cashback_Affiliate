# Port the microservice listens on
PORT=4000

# Run Chromium headless (true) or with a visible window for debugging (false)
HEADLESS=true

# Shared secret n8n must send as `x-api-key` header on every request.
# Generate any random string, e.g. `openssl rand -hex 20`.
SERVICE_API_KEY=change-me

# Where the logged-in browser session (cookies/localStorage) is persisted
# between requests so you don't have to re-inject cookies every call.
STORAGE_STATE_PATH=./storage/storageState.json
