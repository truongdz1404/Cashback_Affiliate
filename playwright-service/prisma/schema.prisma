generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  zaloUserId          String   @unique @map("zalo_user_id")
  phone               String?
  bankName            String?  @map("bank_name")
  bankAccountNumber   String?  @map("bank_account_number")
  bankAccountHolder   String?  @map("bank_account_holder")
  commissionPct       Float?   @map("commission_pct")
  passwordHash        String?  @map("password_hash")
  referralCode        String?  @unique @map("referral_code")
  referredByUserId    Int?     @map("referred_by_user_id")
  email               String?  @unique @map("email")
  googleId            String?  @unique @map("google_id")
  facebookId          String?  @unique @map("facebook_id")
  fullName            String?  @map("full_name")
  // "user" | "admin". One account, one login: an admin signs in exactly like
  // everyone else and this flag is what unlocks the /admin/* API and the
  // dashboard (lib/adminAuth.js#requireAdmin). Promoted via
  // PUT /admin/users/:id/role, scripts/set-role.js, or automatically for the
  // ADMIN_EMAILS allowlist on sign-in.
  role                String   @default("user")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  referredBy          User?    @relation("UserReferredBy", fields: [referredByUserId], references: [id])
  referredUsers       User[]   @relation("UserReferredBy")

  links               Link[]
  searchHistory       SearchHistory[]
  orders              Order[]
  campaignRewards     CampaignReward[]
  referralsAsReferrer Referral[]           @relation("ReferralReferrer")
  referralAsReferred  Referral?            @relation("ReferralReferred")
  referralCommissions ReferralCommission[] @relation("ReferralCommissionReferrer")
  withdrawalRequests  WithdrawalRequest[]
  clawbackFlags       ClawbackFlag[]
  emailVerifications  EmailVerification[]

  @@index([role])
  @@map("users")
}

model Setting {
  key       String   @id
  value     String
  // Bumped automatically on every write; the app config version is the newest
  // updatedAt across the keys the mobile app cares about.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

model Link {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  itemId           String?  @map("item_id")
  subId            String   @unique @map("sub_id")
  shopeeUrl        String?  @map("shopee_url")
  affiliateUrl     String?  @map("affiliate_url")
  estimatedAmount  Float?   @map("estimated_amount")
  estimatedPct     Float?   @map("estimated_pct")
  // Content snapshot of the linked product, best-effort filled from the same
  // addlivetag commission lookup /app/link already makes (see
  // lib/commission.js's getCommissionViaApi) - no extra network call. Powers
  // the recommendation engine (lib/repositories/recommendations.js), which has
  // nothing else to go on since itemId alone rarely matches the scraped
  // shopping_products catalog. Null whenever that lookup fell back to the
  // browser path or failed outright.
  itemName         String?  @map("item_name")
  catId            Int?     @map("cat_id")
  catName          String?  @map("cat_name")
  shopName         String?  @map("shop_name")
  priceValue       Int?     @map("price_value")
  imageUrl         String?  @map("image_url")
  createdAt        DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id])

  @@map("links")
}

// Recent Shopping-tab search terms per user - a lightweight session-behavior
// signal (see lib/repositories/recommendations.js's buildAffinity) alongside
// the link-history one. One row per completed search; server.js only writes
// a row when the term looks intentional (not every debounced keystroke), and
// buildAffinity only reads the most recent handful, so this table is
// expected to stay small - revisit with pruning if usage ever makes it not.
model SearchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  term      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("search_history")
}

model Order {
  id                  Int      @id @default(autoincrement())
  orderSn             String   @unique @map("order_sn")
  userId              Int?     @map("user_id")
  subId               String?  @map("sub_id")
  totalCommission     Float?   @map("total_commission")
  userCommission      Float?   @map("user_commission")
  operatorCommission  Float?   @map("operator_commission")
  displayOrderStatus  Int?     @map("display_order_status")
  payoutStatus        String   @default("unpaid") @map("payout_status")
  paidAt              String?  @map("paid_at")
  purchaseTime        String?  @map("purchase_time")
  productName         String?  @map("product_name")
  rawJson             String?  @map("raw_json")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User?    @relation(fields: [userId], references: [id])
  referralCommission  ReferralCommission?

  @@map("orders")
}

model Campaign {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startsAt    String?  @map("starts_at")
  endsAt      String?  @map("ends_at")
  tiersJson   String   @default("[]") @map("tiers_json")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  rewards     CampaignReward[]

  @@map("campaigns")
}

model CampaignReward {
  id              Int      @id @default(autoincrement())
  campaignId      Int      @map("campaign_id")
  userId          Int      @map("user_id")
  thresholdAmount Float    @map("threshold_amount")
  rewardAmount    Float    @map("reward_amount")
  payoutStatus    String   @default("unpaid") @map("payout_status")
  paidAt          String?  @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")

  campaign        Campaign @relation(fields: [campaignId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId, thresholdAmount])
  @@map("campaign_rewards")
}

// Home-screen slide banners, managed from the admin dashboard so the app
// never needs a new store release to change/add/remove one. `linkUrl` is
// optional - a plain deep link (e.g. rewally://campaigns) or https URL the
// app opens on tap; sortOrder controls left-to-right slide order.
model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}

model Referral {
  id                Int      @id @default(autoincrement())
  referrerUserId    Int      @map("referrer_user_id")
  referredUserId    Int      @unique @map("referred_user_id")
  status            String   @default("pending")
  rewardAmount      Float?   @map("reward_amount")
  createdAt         DateTime @default(now()) @map("created_at")
  qualifiedAt       String?  @map("qualified_at")
  payoutStatus      String   @default("unpaid") @map("payout_status")
  paidAt            String?  @map("paid_at")
  qualifyingOrderId Int?     @map("qualifying_order_id")

  referrer          User     @relation("ReferralReferrer", fields: [referrerUserId], references: [id])
  referred          User     @relation("ReferralReferred", fields: [referredUserId], references: [id])
  commissions       ReferralCommission[]

  @@index([referrerUserId, payoutStatus])
  @@map("referrals")
}

// One row per Completed order placed by a referred user: the referrer's cut
// of that order, taken as `pct` % of the referee's own cashback
// (orders.user_commission) and funded from the operator's share - the
// referee's cashback is never reduced. Created/refreshed by
// lib/repositories/referralCommissions.js syncForCompletedOrder during
// reconciliation, revoked (or clawback-flagged when already paid) when the
// order is later Cancelled. Counted in the withdrawable balance by
// lib/walletBalance.js while unpaid; admin marks rows paid after transfer.
model ReferralCommission {
  id             Int      @id @default(autoincrement())
  referralId     Int      @map("referral_id")
  referrerUserId Int      @map("referrer_user_id")
  referredUserId Int      @map("referred_user_id")
  orderId        Int      @unique @map("order_id")
  pct            Float
  baseAmount     Float    @map("base_amount")
  amount         Float
  payoutStatus   String   @default("unpaid") @map("payout_status")
  paidAt         String?  @map("paid_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  referral       Referral @relation(fields: [referralId], references: [id])
  referrer       User     @relation("ReferralCommissionReferrer", fields: [referrerUserId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])

  @@index([referrerUserId, payoutStatus])
  @@index([referredUserId])
  @@map("referral_commissions")
}

model WithdrawalRequest {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  amount          Float
  method          String   @default("bank")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")
  processedAt     String?  @map("processed_at")
  clientRequestId String?  @unique @map("client_request_id")

  user            User     @relation(fields: [userId], references: [id])

  @@map("withdrawal_requests")
}

// Vietnamese bank directory, synced from the VietQR public API
// (scripts/syncBanks.js) so the app's bank picker doesn't depend on an
// external service at request time. Logos are downloaded and served from
// this server too (see /bank-logos static route in server.js).
model Bank {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  bin        String   @unique
  name       String
  shortName  String   @map("short_name")
  logoPath   String   @map("logo_path")
  swiftCode  String?  @map("swift_code")
  sortOrder  Int      @default(0) @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("banks")
}

// Manual-review queue: written when money already marked paid (order payout,
// referral, or campaign reward) needs reversal because Shopee later reported
// the underlying order as Cancelled. Never auto-reversed - a human confirms
// whether/how to claw the paid-out amount back.
model ClawbackFlag {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  sourceType           String    @map("source_type")
  sourceId             Int       @map("source_id")
  previousPayoutStatus String    @map("previous_payout_status")
  amount               Float
  detectedAt           DateTime  @default(now()) @map("detected_at")
  resolvedAt           DateTime? @map("resolved_at")
  resolvedBy           String?   @map("resolved_by")
  note                 String?

  user                 User      @relation(fields: [userId], references: [id])

  @@map("clawback_flags")
}

// Pending OTP codes for PUT /app/me/email - email is a free-text, unverified
// field (see the account-takeover comment in lib/repositories/users.js), so
// changing it now requires proving control of the new address via a mailed
// one-time code before it's written to users.email. codeHash uses the same
// scrypt hash/verify as user passwords (lib/passwordHash.js); consumedAt/
// attempts prevent replay and brute-forcing a 6-digit code.
model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  newEmail   String    @map("new_email")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, consumedAt])
  @@map("email_verifications")
}

// Product listings scraped every morning from
// https://affiliate.shopee.vn/offer/product_offer (lib/productOfferScraper.js)
// via the "Lấy link hàng loạt" CSV export, so the "Mua sắm" mobile tab has
// ready-made affiliate links without the user visiting Shopee's own
// dashboard. All the *Text fields are kept as the raw strings Shopee's CSV
// exports (e.g. "54,0k", "₫9.180") rather than parsed into numbers - the
// Vietnamese k/tr-suffixed, comma-decimal formatting is easy to mis-parse,
// and this is money-adjacent data. "revenueText" is the CSV's own "Doanh
// thu" column, but its sample values (e.g. "20k+") look like a sold-count,
// not a revenue figure - kept verbatim either way. productId is Shopee's
// item id (unique); re-scraping just upserts fresher price/commission text
// onto the same row.
model ShoppingProduct {
  id                 Int      @id @default(autoincrement())
  productId          String   @unique @map("product_id")
  name               String
  priceText          String?  @map("price_text")
  // VND, parsed from priceText (e.g. "108,0k" -> 108000, "2,8tr" -> 2800000)
  // so the app can filter/sort by price range without re-parsing client-side.
  priceValue         Int?     @map("price_value")
  revenueText        String?  @map("revenue_text")
  shopName           String?  @map("shop_name")
  commissionRateText String?  @map("commission_rate_text")
  commissionText     String?  @map("commission_text")
  // Both parsed from the *Text columns above (e.g. "2,5%" -> 2.5, "₫2.160" ->
  // 2160) - these are Shopee's RAW affiliate-account commission, not what an
  // app user actually receives. The app's cut is commissionSplit.getEffectivePct()
  // applied on top of these at request time (server.js /app/shopping-products),
  // never stored here since the % can change per-user/over time.
  commissionRateValue Float?  @map("commission_rate_value")
  commissionValue     Int?    @map("commission_value")
  productUrl         String?  @map("product_url")
  offerUrl           String?  @map("offer_url")
  // Best-effort: scraped from the product_offer page's DOM (not in Shopee's
  // CSV export), matched to this row by page position - see
  // productOfferScraper.js's scrapeImageMap. Null for admin CSV/XLSX imports,
  // which never have an image column.
  imageUrl           String?  @map("image_url")
  // Real Shopee taxonomy only (e.g. "Thời trang nữ"), sourced exclusively from
  // addlivetag's catPath leaf (see commission.js's pickCatName) - either
  // lib/categoryEnrichment.js's cron backfill for rows missing it, or
  // lib/repositories/shoppingProducts.js's ensureExists for a row created on
  // the fly from a POST /app/link lookup (see server.js). Never written from
  // the scraper's tab label any more (see sourceTab below) so it stays on the
  // same source as Link.catName, which is what the recommendation engine's
  // category-match signal actually compares against.
  category           String?  @map("category")
  // When the backfill last got a real answer about this row from addlivetag -
  // set whether or not that answer carried a category, and left alone when the
  // source never got to the row (budget/cooldown/outage).
  //
  // This exists because "category IS NULL" alone is a queue that can jam. The
  // backfill takes the oldest N null rows every tick, so a handful addlivetag
  // genuinely can't classify would sit at the head forever and starve every
  // row behind them - which is exactly what happened while catPath was being
  // read under the wrong key: 30 scanned, 30 failed, same 30 rows, every 15
  // minutes. Stamping the attempt rotates those to the back instead.
  categoryCheckedAt  DateTime? @map("category_checked_at")
  // The product_offer tab this row was scraped under, verbatim (e.g. "Tất cả",
  // "Bán chạy nhất", "Hoa hồng Xtra", or a real category name) - kept as a raw
  // audit trail of where the row came from. isBestSeller/isXtraCommission below
  // are the two pseudo-tags worth querying on directly; everything else here is
  // informational only. Null for admin CSV/XLSX imports.
  sourceTab          String?  @map("source_tab")
  // True when scraped under Shopee's "Bán chạy nhất" tab.
  isBestSeller       Boolean  @default(false) @map("is_best_seller")
  // True when scraped under Shopee's "Hoa hồng Xtra" tab, or when addlivetag's
  // own `isXtra` flag says so (see commission.js's getCommissionViaApi meta).
  isXtraCommission   Boolean  @default(false) @map("is_xtra_commission")
  // Set either by the per-shop crawler (which walks brand_offer/<shop_id>, so
  // the shop is known from the URL and never has to be matched by name) or by
  // lib/shopResolution.js's name-resolution job. FK is SetNull: deleting a shop
  // must never delete or block a product row.
  //
  // CAREFUL: upsertMany below spreads {...p} into `update` too, and Prisma
  // writes an explicit `null` (it only skips `undefined`). Any mapper feeding
  // it must therefore leave shopId `undefined`, not `null` - otherwise an
  // ordinary product_offer re-scrape silently wipes the shopId the resolver
  // just wrote. Same contract as shoppingProductMapper.js:64-67.
  shopId             String?  @map("shop_id")
  shop               Shop?    @relation(fields: [shopId], references: [shopId], onDelete: SetNull, onUpdate: Cascade)
  // When lib/shopLinkBackfill.js last asked addlivetag about this row's shop,
  // answer or not. Exactly the same role categoryCheckedAt plays above, for
  // exactly the same reason: products addlivetag has no shop id for would
  // otherwise hold the front of the backfill queue permanently.
  shopCheckedAt      DateTime? @map("shop_checked_at")
  scrapedAt          DateTime @default(now()) @map("scraped_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([priceValue])
  @@index([commissionValue])
  @@index([shopId])
  // The name-resolution job groupBy's and updateMany's on this column. No
  // normalised `shop_name_key` companion column on purpose: matching is exact
  // string equality (Shopee's API returns the same shop_name the product CSV
  // carries), so there is nothing to normalise.
  @@index([shopName])
  // Drives lib/categoryEnrichment.js's queue: the null-category rows least
  // recently asked about, oldest first.
  @@index([category, categoryCheckedAt])
  // Same shape for lib/shopLinkBackfill.js: the null-shop rows least recently
  // asked about.
  @@index([shopId, shopCheckedAt])
  @@map("shopping_products")
}

// A shop in Shopee's affiliate programme. shop_id is the natural key every
// Shopee surface uses (brand_offer/<id>, shopee.vn/shop/<id>, the universal
// link's /shop/<id> path), so products FK onto shopId rather than this table's
// autoincrement id - it keeps the crawler's "I know the shop_id, link this
// row" path free of an extra lookup.
//
// Rows arrive from GET /api/v3/offer/shop/list, which matches keywords FUZZILY:
// searching one product's shop name routinely returns several other shops whose
// names merely contain the keyword. Those are kept too (a free shop discovery)
// but stay `discovered` until they actually have products.
model Shop {
  id                  Int       @id @default(autoincrement())
  shopId              String    @unique @map("shop_id")
  // Shopee's shop_name VERBATIM. Never lowercased, never de-accented, never
  // suffix-trimmed - the resolution job compares this to ShoppingProduct.shopName
  // with plain `===`, and any normalisation here would break that contract.
  name                String
  // discovered = only ever seen in a fuzzy search result, has no products in
  //              this DB yet -> NOT shown to app users.
  // linked     = matched a real product's shop name exactly, or a crawl of this
  //              shop produced products -> eligible to be shown.
  status              String    @default("discovered")
  imageUrl            String?   @map("image_url")
  portraitUrl         String?   @map("portrait_url")
  coverUrl            String?   @map("cover_url")
  shopUrl             String?   @map("shop_url")
  // The affiliate link Shopee itself generates for this shop. Its subId slots
  // are EMPTY, so it earns nobody any cashback - kept only as a byte-for-byte
  // reference for the link builder (docs/shopee-affiliate-api-spec.txt §3),
  // never served to an app user as-is.
  longLink            String?   @map("long_link")
  commissionRateText  String?   @map("commission_rate_text")
  commissionRateValue Float?    @map("commission_rate_value")
  periodStartTime     DateTime? @map("period_start_time")
  // Shopee uses 32503651199 (year 2999) to mean "no end date".
  periodEndTime       DateTime? @map("period_end_time")
  offerType           Int?      @map("offer_type")
  bannerCount         Int?      @map("banner_count")
  rating              Float?
  soldTotal           Int?      @map("sold_total")
  followerCount       Int?      @map("follower_count")
  followersText       String?   @map("followers_text")
  // Denormalised count of linked products, refreshed by shops.refreshProductCounts.
  // Every shop listing shows this number; counting per row would be an N+1 on
  // every app request.
  productCount        Int       @default(0) @map("product_count")
  isActive            Boolean   @default(true)  @map("is_active")
  isFeatured          Boolean   @default(false) @map("is_featured")
  sortOrder           Int       @default(0)     @map("sort_order")
  source              String    @default("name_search")
  detailFetchedAt     DateTime? @map("detail_fetched_at")
  // When the detail endpoint was last ASKED about this shop, whether or not it
  // answered - the pair to detailFetchedAt above, and the reason the enrichment
  // queue drains. Ordering the queue by detailFetchedAt alone would let a shop
  // Shopee can't answer about sit at the head of it forever.
  detailCheckedAt     DateTime? @map("detail_checked_at")
  // Null means "never crawled" - that IS the crawl queue (same null-column-as-
  // queue idiom lib/categoryEnrichment.js uses for `category`).
  lastCrawledAt       DateTime? @map("last_crawled_at")
  lastCrawlError      String?   @map("last_crawl_error")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  products            ShoppingProduct[]
  resolutions         ShopNameResolution[]

  @@index([status, productCount])
  @@index([isFeatured, sortOrder])
  @@index([lastCrawledAt])
  @@index([detailFetchedAt, detailCheckedAt])
  @@map("shops")
}

// Queue AND memory for resolving a product's shop_name into a shop_id.
//
// Deliberately a real table rather than the "column IS NULL is the queue"
// pattern of lib/categoryEnrichment.js: a shop name that simply isn't in the
// affiliate programme will NEVER resolve, and without remembering that, the
// cron would ask Shopee about it again every ten minutes forever - the fastest
// way to get the account rate-limited, which docs/shopee-affiliate-api-spec.txt
// §8 warns is already a live risk for offer/shop/list.
model ShopNameResolution {
  id             Int       @id @default(autoincrement())
  // Verbatim (trimmed) copy of ShoppingProduct.shopName.
  shopName       String    @unique @map("shop_name")
  // pending | resolved | ambiguous | not_found | error
  status         String    @default("pending")
  shopId         String?   @map("shop_id")
  // The whole last search response, so an admin can pick by hand when two shops
  // share a display name (`ambiguous`).
  candidatesJson String?   @map("candidates_json")
  // How many products carry this name - the queue works the most impactful
  // names first.
  productCount   Int       @default(0) @map("product_count")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  nextAttemptAt  DateTime? @map("next_attempt_at")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  shop           Shop?     @relation(fields: [shopId], references: [shopId], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, nextAttemptAt])
  @@map("shop_name_resolutions")
}

// One row per execution of a background job. Until now a job's outcome lived
// only in a module-level variable (lib/productOfferSyncJob.js) or was
// console.logged and forgotten (lib/categoryEnrichment.js), and this repo
// auto-deploys on every push to master - so the one place that knew whether
// last night's scrape worked was wiped several times a week. An anti-bot
// block or an expired session needs to leave a trace that outlives a restart.
model JobRun {
  id         Int       @id @default(autoincrement())
  // product-offer-sync | category-backfill | shop-name-resolve | shop-product-crawl
  job        String
  // running | done | error
  status     String    @default("running")
  // cron | admin | boot
  trigger    String    @default("cron")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")
  // The job's own return value, verbatim. Kept as text rather than Json so a
  // job that changes its counters never needs a migration.
  resultJson String?   @map("result_json")
  error      String?

  @@index([job, startedAt])
  @@map("job_runs")
}
