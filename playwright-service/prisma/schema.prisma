generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  zaloUserId          String   @unique @map("zalo_user_id")
  phone               String?
  bankName            String?  @map("bank_name")
  bankAccountNumber   String?  @map("bank_account_number")
  bankAccountHolder   String?  @map("bank_account_holder")
  commissionPct       Float?   @map("commission_pct")
  passwordHash        String?  @map("password_hash")
  referralCode        String?  @unique @map("referral_code")
  referredByUserId    Int?     @map("referred_by_user_id")
  email               String?  @unique @map("email")
  googleId            String?  @unique @map("google_id")
  facebookId          String?  @unique @map("facebook_id")
  fullName            String?  @map("full_name")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  referredBy          User?    @relation("UserReferredBy", fields: [referredByUserId], references: [id])
  referredUsers       User[]   @relation("UserReferredBy")

  links               Link[]
  orders              Order[]
  campaignRewards     CampaignReward[]
  referralsAsReferrer Referral[]           @relation("ReferralReferrer")
  referralAsReferred  Referral?            @relation("ReferralReferred")
  withdrawalRequests  WithdrawalRequest[]
  clawbackFlags       ClawbackFlag[]
  emailVerifications  EmailVerification[]

  @@map("users")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model Link {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  itemId           String?  @map("item_id")
  subId            String   @unique @map("sub_id")
  shopeeUrl        String?  @map("shopee_url")
  affiliateUrl     String?  @map("affiliate_url")
  estimatedAmount  Float?   @map("estimated_amount")
  estimatedPct     Float?   @map("estimated_pct")
  createdAt        DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id])

  @@map("links")
}

model Order {
  id                  Int      @id @default(autoincrement())
  orderSn             String   @unique @map("order_sn")
  userId              Int?     @map("user_id")
  subId               String?  @map("sub_id")
  totalCommission     Float?   @map("total_commission")
  userCommission      Float?   @map("user_commission")
  operatorCommission  Float?   @map("operator_commission")
  displayOrderStatus  Int?     @map("display_order_status")
  payoutStatus        String   @default("unpaid") @map("payout_status")
  paidAt              String?  @map("paid_at")
  purchaseTime        String?  @map("purchase_time")
  productName         String?  @map("product_name")
  rawJson             String?  @map("raw_json")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User?    @relation(fields: [userId], references: [id])

  @@map("orders")
}

model Campaign {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startsAt    String?  @map("starts_at")
  endsAt      String?  @map("ends_at")
  tiersJson   String   @default("[]") @map("tiers_json")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  rewards     CampaignReward[]

  @@map("campaigns")
}

model CampaignReward {
  id              Int      @id @default(autoincrement())
  campaignId      Int      @map("campaign_id")
  userId          Int      @map("user_id")
  thresholdAmount Float    @map("threshold_amount")
  rewardAmount    Float    @map("reward_amount")
  payoutStatus    String   @default("unpaid") @map("payout_status")
  paidAt          String?  @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")

  campaign        Campaign @relation(fields: [campaignId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId, thresholdAmount])
  @@map("campaign_rewards")
}

// Home-screen slide banners, managed from the admin dashboard so the app
// never needs a new store release to change/add/remove one. `linkUrl` is
// optional - a plain deep link (e.g. rewally://campaigns) or https URL the
// app opens on tap; sortOrder controls left-to-right slide order.
model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}

model Referral {
  id                Int      @id @default(autoincrement())
  referrerUserId    Int      @map("referrer_user_id")
  referredUserId    Int      @unique @map("referred_user_id")
  status            String   @default("pending")
  rewardAmount      Float?   @map("reward_amount")
  createdAt         DateTime @default(now()) @map("created_at")
  qualifiedAt       String?  @map("qualified_at")
  payoutStatus      String   @default("unpaid") @map("payout_status")
  paidAt            String?  @map("paid_at")
  qualifyingOrderId Int?     @map("qualifying_order_id")

  referrer          User     @relation("ReferralReferrer", fields: [referrerUserId], references: [id])
  referred          User     @relation("ReferralReferred", fields: [referredUserId], references: [id])

  @@index([referrerUserId, payoutStatus])
  @@map("referrals")
}

model WithdrawalRequest {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  amount          Float
  method          String   @default("bank")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")
  processedAt     String?  @map("processed_at")
  clientRequestId String?  @unique @map("client_request_id")

  user            User     @relation(fields: [userId], references: [id])

  @@map("withdrawal_requests")
}

// Vietnamese bank directory, synced from the VietQR public API
// (scripts/syncBanks.js) so the app's bank picker doesn't depend on an
// external service at request time. Logos are downloaded and served from
// this server too (see /bank-logos static route in server.js).
model Bank {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  bin        String   @unique
  name       String
  shortName  String   @map("short_name")
  logoPath   String   @map("logo_path")
  swiftCode  String?  @map("swift_code")
  sortOrder  Int      @default(0) @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("banks")
}

// Manual-review queue: written when money already marked paid (order payout,
// referral, or campaign reward) needs reversal because Shopee later reported
// the underlying order as Cancelled. Never auto-reversed - a human confirms
// whether/how to claw the paid-out amount back.
model ClawbackFlag {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  sourceType           String    @map("source_type")
  sourceId             Int       @map("source_id")
  previousPayoutStatus String    @map("previous_payout_status")
  amount               Float
  detectedAt           DateTime  @default(now()) @map("detected_at")
  resolvedAt           DateTime? @map("resolved_at")
  resolvedBy           String?   @map("resolved_by")
  note                 String?

  user                 User      @relation(fields: [userId], references: [id])

  @@map("clawback_flags")
}

// Pending OTP codes for PUT /app/me/email - email is a free-text, unverified
// field (see the account-takeover comment in lib/repositories/users.js), so
// changing it now requires proving control of the new address via a mailed
// one-time code before it's written to users.email. codeHash uses the same
// scrypt hash/verify as user passwords (lib/passwordHash.js); consumedAt/
// attempts prevent replay and brute-forcing a 6-digit code.
model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  newEmail   String    @map("new_email")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, consumedAt])
  @@map("email_verifications")
}

// Product listings scraped every morning from
// https://affiliate.shopee.vn/offer/product_offer (lib/productOfferScraper.js)
// via the "Lấy link hàng loạt" CSV export, so the "Mua sắm" mobile tab has
// ready-made affiliate links without the user visiting Shopee's own
// dashboard. All the *Text fields are kept as the raw strings Shopee's CSV
// exports (e.g. "54,0k", "₫9.180") rather than parsed into numbers - the
// Vietnamese k/tr-suffixed, comma-decimal formatting is easy to mis-parse,
// and this is money-adjacent data. "revenueText" is the CSV's own "Doanh
// thu" column, but its sample values (e.g. "20k+") look like a sold-count,
// not a revenue figure - kept verbatim either way. productId is Shopee's
// item id (unique); re-scraping just upserts fresher price/commission text
// onto the same row.
model ShoppingProduct {
  id                 Int      @id @default(autoincrement())
  productId          String   @unique @map("product_id")
  name               String
  priceText          String?  @map("price_text")
  // VND, parsed from priceText (e.g. "108,0k" -> 108000, "2,8tr" -> 2800000)
  // so the app can filter/sort by price range without re-parsing client-side.
  priceValue         Int?     @map("price_value")
  revenueText        String?  @map("revenue_text")
  shopName           String?  @map("shop_name")
  commissionRateText String?  @map("commission_rate_text")
  commissionText     String?  @map("commission_text")
  // Both parsed from the *Text columns above (e.g. "2,5%" -> 2.5, "₫2.160" ->
  // 2160) - these are Shopee's RAW affiliate-account commission, not what an
  // app user actually receives. The app's cut is commissionSplit.getEffectivePct()
  // applied on top of these at request time (server.js /app/shopping-products),
  // never stored here since the % can change per-user/over time.
  commissionRateValue Float?  @map("commission_rate_value")
  commissionValue     Int?    @map("commission_value")
  productUrl         String?  @map("product_url")
  offerUrl           String?  @map("offer_url")
  // Best-effort: scraped from the product_offer page's DOM (not in Shopee's
  // CSV export), matched to this row by page position - see
  // productOfferScraper.js's scrapeImageMap. Null for admin CSV/XLSX imports,
  // which never have an image column.
  imageUrl           String?  @map("image_url")
  scrapedAt          DateTime @default(now()) @map("scraped_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([priceValue])
  @@index([commissionValue])
  @@map("shopping_products")
}
