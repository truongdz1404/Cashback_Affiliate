# Without this file the builder's `COPY . .` drops the Windows/macOS
# node_modules of whoever runs the build on top of the Linux ones installed
# in the deps stage, and the native binaries (lightningcss, sharp) then fail
# to load. Keep the host's build output out of the image as well.
node_modules
.next
.git
.gitignore
.claude
tsconfig.tsbuildinfo

# Runtime configuration comes from docker-compose, never from a baked-in file.
.env
.env.local
.env.*.local

npm-debug.log*
