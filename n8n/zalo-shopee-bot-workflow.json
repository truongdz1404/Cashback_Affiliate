      }
    },
    {
      "id": "z3",
      "name": "Verify Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [500, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$('Zalo Webhook').item.json.headers['x-bot-api-secret-token']}}",
