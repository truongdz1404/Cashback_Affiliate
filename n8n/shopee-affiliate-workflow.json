{
  "name": "Shopee Affiliate - Login + Custom Link + Commission",
  "nodes": [
    {
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "shopee-affiliate",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [250, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "serviceUrl", "value": "http://localhost:4000", "type": "string" },
            { "id": "a2", "name": "apiKey", "value": "change-me", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Has Cookies?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [500, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$('Webhook').item.json.body.cookies}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 180],
      "parameters": {
        "method": "POST",
        "url": "={{$('Config').item.json.serviceUrl}}/login",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-api-key", "value": "={{$('Config').item.json.apiKey}}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"cookies\": $('Webhook').item.json.body.cookies } }}",
        "options": {}
      }
    },
    {
      "id": "n5",
      "name": "Get Custom Link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 220],
      "parameters": {
        "method": "POST",
        "url": "={{$('Config').item.json.serviceUrl}}/custom-link",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-api-key", "value": "={{$('Config').item.json.apiKey}}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"links\": $('Webhook').item.json.body.links, \"subIds\": $('Webhook').item.json.body.subIds } }}",
        "options": {}
      }
    },
    {
      "id": "n6",
      "name": "Get Commission",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 400],
      "parameters": {
        "method": "GET",
        "url": "={{$('Config').item.json.serviceUrl}}/commission/{{$('Webhook').item.json.body.pid}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-api-key", "value": "={{$('Config').item.json.apiKey}}" }]
        },
        "options": {}
      }
    },
    {
      "id": "n7",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [1250, 300],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      }
    },
    {
      "id": "n8",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1500, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Has Cookies?", "type": "main", "index": 0 }]] },
    "Has Cookies?": {
      "main": [
        [{ "node": "Login", "type": "main", "index": 0 }],
        [
          { "node": "Get Custom Link", "type": "main", "index": 0 },
          { "node": "Get Commission", "type": "main", "index": 0 }
        ]
      ]
    },
    "Login": {
      "main": [
        [
          { "node": "Get Custom Link", "type": "main", "index": 0 },
          { "node": "Get Commission", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Custom Link": { "main": [[{ "node": "Merge", "type": "main", "index": 0 }]] },
    "Get Commission": { "main": [[{ "node": "Merge", "type": "main", "index": 1 }]] },
    "Merge": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
